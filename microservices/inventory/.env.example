# Postgres connection string shared by all three services (required — the
# service exits on startup if unset). Neon URLs with ?sslmode=require work as-is.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dropship

# Listen port
PORT=8080

# Simulated fulfillment delay before a confirmed order ships (used by the
# /api/ship endpoint)
SHIP_DELAY_SECONDS=10
