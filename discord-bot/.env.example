DISCORD_APP_ID=          # Application ID (General Information page)
DISCORD_PUBLIC_KEY=      # Public Key, used to verify inbound interaction signatures
DISCORD_BOT_TOKEN=       # Bot token, used as "Authorization: Bot <token>" for REST calls
DISCORD_GUILD_ID=        # Test server (guild) ID — commands register here for instant updates
DISCORD_CHANNEL_ID=      # Channel the scheduled joke is posted to
CRON_SECRET=             # shared secret; /cron requires this so randoms can't trigger posts
PORT=3000
